# .terraform.lock.hcl

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Environment variable files
.env
.env.*
!.env.example

# SSH keys
*.pem
*.key

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/settings.json
*.swp
*.swo

# Logs
*.log

# Scripts output
scripts/*.out
